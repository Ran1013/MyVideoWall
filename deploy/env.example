# 视频站配置（systemd 读取）：改完执行 systemctl restart videowall

# 监听端口（安全组放行这个端口）
PORT=8080

# 观看密码（发给朋友）
VIEW_PASSWORD=view123

# 上传/管理密码（自己留）
UPLOAD_PASSWORD=upload123

# MySQL：程序与数据库同机，必须用 127.0.0.1（环回，更快更安全）；
# 切勿改成公网 IP —— 那会消耗公网带宽，且 3306 暴露公网会被全网爆破。
# 格式：用户:密码@tcp(127.0.0.1:3306)/库名?charset=utf8mb4&parseTime=true
MYSQL_DSN=MyVideos:change_me@tcp(127.0.0.1:3306)/MyVideos?charset=utf8mb4&parseTime=true

# 数据目录（一般不用改）
VIDEO_DIR=/opt/videowall/videos
CHUNKS_DIR=/opt/videowall/chunks
IP2REGION_XDB=/opt/videowall/data/ip2region.xdb

# 其它可选项（不填用默认值）
# ALLOW_ORIGIN=            前端跨域来源（同源部署留空）
# PAGE_SIZE=60             首页每页条数
# CHUNK_MB=4               上传分片大小（MB）
# CHUNK_TTL_HOURS=24       未完成上传会话保留小时数
# TOKEN_TTL_DAYS=30        登录 token 有效期（天）
# ALLOWED_EXT=mp4,webm,m4v,mov,mkv
